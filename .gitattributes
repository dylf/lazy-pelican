# Files that exist for development only. `git archive` (used by the release workflow) leaves these out of the
# plugin zip, so the zip contains just what the panel needs.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.json export-ignore
/phpunit.xml export-ignore
/phpstan.neon export-ignore
/pint.json export-ignore
/tests export-ignore
/release-please-config.json export-ignore
/.release-please-manifest.json export-ignore
/agent export-ignore
/screenshots export-ignore
